{
  "version": 8,
  "name": "Palmas offline",
  "glyphs": "asset://palmas/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "roads": {
      "type": "geojson",
      "data": "asset://palmas/roads.geojson"
    },
    "areas": {
      "type": "geojson",
      "data": "asset://palmas/areas.geojson"
    },
    "waterways": {
      "type": "geojson",
      "data": "asset://palmas/waterways.geojson"
    },
    "places": {
      "type": "geojson",
      "data": "asset://palmas/places.geojson"
    },
    "route": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "origin": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "destination": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F1F2ED"
      }
    },
    {
      "id": "urban",
      "type": "fill",
      "source": "areas",
      "filter": [
        "==",
        "kind",
        "urban"
      ],
      "minzoom": 0,
      "paint": {
        "fill-color": "#F8F7F3"
      }
    },
    {
      "id": "green",
      "type": "fill",
      "source": "areas",
      "filter": [
        "==",
        "kind",
        "green"
      ],
      "minzoom": 0,
      "paint": {
        "fill-color": "#D6E7CB"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "areas",
      "filter": [
        "==",
        "kind",
        "water"
      ],
      "minzoom": 0,
      "paint": {
        "fill-color": "#B5D8E8"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "areas",
      "filter": [
        "==",
        "kind",
        "building"
      ],
      "minzoom": 15,
      "paint": {
        "fill-color": "#DFDFD6"
      }
    },
    {
      "id": "streams",
      "type": "line",
      "source": "waterways",
      "paint": {
        "line-color": "#91C4DB",
        "line-width": 1.5
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "roads",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D1D3CA",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          [
            "+",
            [
              "*",
              0.7,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            1.5
          ],
          14,
          [
            "+",
            [
              "*",
              3,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            1.5
          ],
          17,
          [
            "+",
            [
              "*",
              8,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            1.5
          ],
          20,
          [
            "+",
            [
              "*",
              16,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            1.5
          ]
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "roads",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "motorway",
            "trunk",
            "primary"
          ],
          "#F8D99B",
          "#FFFFFF"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          [
            "+",
            [
              "*",
              0.7,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            0
          ],
          14,
          [
            "+",
            [
              "*",
              3,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            0
          ],
          17,
          [
            "+",
            [
              "*",
              8,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            0
          ],
          20,
          [
            "+",
            [
              "*",
              16,
              [
                "match",
                [
                  "get",
                  "kind"
                ],
                [
                  "motorway",
                  "trunk",
                  "primary"
                ],
                1.6,
                [
                  "secondary",
                  "tertiary"
                ],
                1.2,
                [
                  "footway",
                  "path",
                  "cycleway",
                  "steps"
                ],
                0.5,
                1
              ]
            ],
            0
          ]
        ]
      }
