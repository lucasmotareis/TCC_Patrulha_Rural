    {
      "id": "route-casing",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 9
      }
    },
    {
      "id": "route-line",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#006B5E",
        "line-width": 5
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "roads",
      "minzoom": 14,
      "filter": [
        "!=",
        "name",
        ""
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#555D54",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "places",
      "minzoom": 10,
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 15
      },
      "paint": {
        "text-color": "#34463D",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2
      }
    },
    {
      "id": "origin-circle",
      "type": "circle",
      "source": "origin",
      "paint": {
        "circle-radius": 13,
        "circle-color": "#006B5E",
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 3
      }
    },
    {
      "id": "origin-label",
      "type": "symbol",
      "source": "origin",
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 13,
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "#FFFFFF"
      }
    },
    {
      "id": "destination-circle",
      "type": "circle",
      "source": "destination",
      "paint": {
        "circle-radius": 13,
        "circle-color": "#B84920",
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 3
      }
    },
    {
      "id": "destination-label",
      "type": "symbol",
      "source": "destination",
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": 13,
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "#FFFFFF"
      }
    }
